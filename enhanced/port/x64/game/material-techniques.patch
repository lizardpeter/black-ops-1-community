+template <typename T>
+const unsigned char *ReadMaterialRecords(unsigned int count)
+{
+    const auto size = static_cast<int>(sizeof(T) * count);
+    auto *data = DB_GetNativeStreamSpan(3, size);
+    if (data && size)
+        Load_Stream(true, data, size);
+    return data;
+}
+
+template <typename T>
+T MaterialRecordAt(const unsigned char *data, unsigned int index = 0)
+{
+    T record{};
+    std::memcpy(&record, data + sizeof(T) * index, sizeof(T));
+    return record;
+}
+
+template <typename T>
+T *AllocateMaterialData(unsigned int count = 1, std::size_t extra = 0)
+{
+    static_assert(alignof(T) <= alignof(std::max_align_t));
+    auto *data = DB_AllocateNativeZoneData(g_streamBlocks, sizeof(T) * count + extra);
+    return new (data) T[count]{};
+}
+
+template <typename T, typename Load>
+T *LoadMaterialReference(std::uint32_t encoded, XAssetType type, Load load)
+{
+    const auto reference = bo1::DecodeFastfileReference(encoded);
+    if (reference.kind == bo1::ReferenceKind::absent)
+        return nullptr;
+    if (reference.kind != bo1::ReferenceKind::inlineData)
+        return static_cast<T *>(DB_FindNativeAssetAlias(encoded, type));
+    const auto *slot = DB_GetNativeStreamSpan(3, 1);
+    if (!slot)
+        return nullptr;
+    auto *asset = load();
+    if (asset)
+        DB_RecordNativeAssetAlias(slot, type, asset);
+    return asset;
+}
+
+MaterialVertexDeclaration *LoadNativeVertexDeclaration()
+{
+    const auto *bytes = ReadMaterialRecords<DiskDeclaration>(1);
+    if (!bytes)
+        return nullptr;
+    const auto record = MaterialRecordAt<DiskDeclaration>(bytes);
+    if (record.streamCount > 16)
+    {
+        Com_Error(ERR_DROP, "Invalid material vertex stream count");
+        return nullptr;
+    }
+    auto *declaration = AllocateMaterialData<MaterialVertexDeclaration>();
+    declaration->streamCount = record.streamCount;
+    declaration->hasOptionalSource = record.hasOptionalSource != 0;
+    std::memcpy(declaration->routing.data, record.routes, sizeof(record.routes));
+    Load_BuildVertexDecl(&declaration);
+    return declaration;
+}
+
+template <typename T, typename Create>
+T *LoadNativeMaterialShader(Create create)
+{
+    const auto *bytes = ReadMaterialRecords<DiskShader>(1);
+    if (!bytes)
+        return nullptr;
+    const auto record = MaterialRecordAt<DiskShader>(bytes);
+    auto *shader = AllocateMaterialData<T>();
+    shader->name = DB_ReadNativeAssetName(record.name);
+    if (record.program && record.programSize)
+    {
+        const auto *program = ReadMaterialRecords<DWORD>(record.programSize);
+        if (program)
+        {
+            shader->prog.loadDef.program = reinterpret_cast<DWORD *>(const_cast<unsigned char *>(program));
+            shader->prog.loadDef.programSize = record.programSize;
+            create(&shader->prog.loadDef, shader);
+        }
+    }
+    return shader;
+}
+
+const float *LoadMaterialLiteral(std::uint32_t encoded)
+{
+    const auto reference = bo1::DecodeFastfileReference(encoded);
+    if (reference.kind == bo1::ReferenceKind::absent)
+        return nullptr;
+    if (reference.kind == bo1::ReferenceKind::inlineData)
+        return reinterpret_cast<const float *>(ReadMaterialRecords<float>(4));
+    if (reference.kind == bo1::ReferenceKind::blockOffset)
+    {
+        const auto &block = g_streamBlocks[reference.block];
+        if (block.data && reference.offset % alignof(float) == 0 &&
+            reference.offset <= block.size && sizeof(float) * 4 <= block.size - reference.offset)
+            return reinterpret_cast<const float *>(block.data + reference.offset);
+    }
+    Com_Error(ERR_DROP, "Invalid material literal reference");
+    return nullptr;
+}
+
+MaterialShaderArgument *LoadNativeMaterialArguments(unsigned int count)
+{
+    if (!count)
+        return nullptr;
+    const auto *records = ReadMaterialRecords<DiskArgument>(count);
+    if (!records)
+        return nullptr;
+    auto *args = AllocateMaterialData<MaterialShaderArgument>(count);
+    for (unsigned int i = 0; i < count; ++i)
+    {
+        const auto record = MaterialRecordAt<DiskArgument>(records, i);
+        auto &arg = args[i];
+        arg.type = record.type;
+        arg.dest = record.dest;
+        if (record.type == 1 || record.type == 7)
+            arg.u.literalConst = LoadMaterialLiteral(record.value);
+        else if (record.type == 3 || record.type == 5)
+            std::memcpy(&arg.u.codeConst, &record.value, sizeof(record.value));
+        else
+            arg.u.codeSampler = record.value;
+    }
+    return args;
+}
+
+MaterialTechnique *LoadNativeTechnique()
+{
+    const auto *bytes = ReadMaterialRecords<DiskTechnique>(1);
+    if (!bytes)
+        return nullptr;
+    const auto record = MaterialRecordAt<DiskTechnique>(bytes);
+    const auto *passes = ReadMaterialRecords<DiskPass>(record.passCount);
+    if (!passes)
+        return nullptr;
+    const auto extra = record.passCount > 1 ? (record.passCount - 1) * sizeof(MaterialPass) : 0;
+    auto *technique = AllocateMaterialData<MaterialTechnique>(1, extra);
+    technique->flags = record.flags;
+    technique->passCount = record.passCount;
+    for (unsigned int i = 0; i < record.passCount; ++i)
+    {
+        const auto disk = MaterialRecordAt<DiskPass>(passes, i);
+        auto *passStorage = reinterpret_cast<unsigned char *>(technique) +
+            offsetof(MaterialTechnique, passArray) + i * sizeof(MaterialPass);
+        auto &pass = *new (passStorage) MaterialPass{};
+        pass.vertexDecl = LoadMaterialReference<MaterialVertexDeclaration>(
+            disk.declaration, vertexDeclAliasType, LoadNativeVertexDeclaration);
+        pass.vertexShader = LoadMaterialReference<MaterialVertexShader>(
+            disk.vertex, vertexShaderAliasType, [] {
+                return LoadNativeMaterialShader<MaterialVertexShader>(Load_CreateMaterialVertexShader);
+            });
+        pass.pixelShader = LoadMaterialReference<MaterialPixelShader>(
+            disk.pixel, pixelShaderAliasType, [] {
+                return LoadNativeMaterialShader<MaterialPixelShader>(Load_CreateMaterialPixelShader);
+            });
+        pass.perPrimArgCount = disk.perPrim;
+        pass.perObjArgCount = disk.perObject;
+        pass.stableArgCount = disk.stable;
+        pass.customSamplerFlags = disk.samplerFlags;
+        if (disk.arguments)
+            pass.args = LoadNativeMaterialArguments(disk.perPrim + disk.perObject + disk.stable);
+    }
+    technique->name = DB_ReadNativeAssetName(record.name);
+    BO1_CaptureMaterialShaders(*technique);
+    return technique;
+}
