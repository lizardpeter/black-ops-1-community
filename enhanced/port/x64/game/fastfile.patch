+    const auto position = reinterpret_cast<std::uintptr_t>(data);
+    const auto base = reinterpret_cast<std::uintptr_t>(block.data);
+    if (!block.data || position < base || position - base > block.size ||
+        static_cast<unsigned int>(size) > block.size - (position - base))
+    {
+        Com_Error(ERR_DROP, "Fastfile array exceeds the stream block in '%s'", g_load.filename);
+        return nullptr;
+    }
+    Load_Stream(true, data, size);
+    return data;
