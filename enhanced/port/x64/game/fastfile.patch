+unsigned char *LoadFastfileArray(int count, unsigned int stride)
+{
+    if (count < 0 || static_cast<unsigned int>(count) >
+            static_cast<unsigned int>((std::numeric_limits<int>::max)()) / stride)
+    {
+        Com_Error(ERR_DROP, "Invalid fastfile array count in '%s'", g_load.filename);
