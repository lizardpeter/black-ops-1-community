+namespace
+{
+template <typename T>
+unsigned char *ReadTableRecords(unsigned int count, int alignment = 3)
+{
+    if (count > INT32_MAX / sizeof(T))
+    {
+        Com_Error(ERR_DROP, "Fastfile table exceeds supported size");
+        return nullptr;
+    }
+    const auto size = static_cast<int>(sizeof(T) * count);
+    auto *data = DB_GetNativeStreamSpan(alignment, size);
+    if (data && size)
+        Load_Stream(true, data, size);
+    return data;
+}
+
+template <typename T>
+bool ReadTableHeader(bool atStreamStart, T &disk)
+{
+    if (!atStreamStart)
+    {
+        Com_Error(ERR_DROP, "Fastfile table header must be read at stream start");
+        return false;
+    }
+    const auto *bytes = ReadTableRecords<T>(1);
+    if (!bytes)
+        return false;
+    std::memcpy(&disk, bytes, sizeof(disk));
+    return true;
+}
+
+template <typename T>
+void LoadNativeTableAsset(bool atStreamStart, T *&target, T *&current, XAssetType type,
+                          T *XAssetHeader::*member, void (__cdecl *load)(bool),
+                          void (__cdecl *registerAsset)(XAssetHeader *))
+{
+    std::uint32_t encoded;
+    const unsigned char *sourceSlot = nullptr;
+    if (atStreamStart)
+    {
+        sourceSlot = ReadTableRecords<std::uint32_t>(1);
+        if (!sourceSlot)
+            return;
+        std::memcpy(&encoded, sourceSlot, sizeof(encoded));
+    }
+    else
+    {
+        encoded = static_cast<std::uint32_t>(reinterpret_cast<std::uintptr_t>(target));
+    }
+
+    DB_PushStreamPos(0);
+    target = nullptr;
+    const auto kind = bo1::DecodeFastfileReference(encoded).kind;
+    if (kind == bo1::ReferenceKind::inlineData || kind == bo1::ReferenceKind::inlineWithFixup)
+    {
+        const unsigned char *fixup = nullptr;
+        if (kind == bo1::ReferenceKind::inlineWithFixup)
+        {
+            DB_PushStreamPos(4);
+            fixup = DB_GetNativeStreamSpan(3, sizeof(encoded));
+            if (fixup)
+                DB_IncStreamPos(sizeof(encoded));
+            DB_PopStreamPos();
+        }
+        if (kind == bo1::ReferenceKind::inlineData || fixup)
+        {
+            T loaded{};
+            current = &loaded;
+            load(true);
+            if (loaded.name)
+            {
+                XAssetHeader asset(&loaded);
+                registerAsset(&asset);
+                target = asset.*member;
+                if (fixup)
+                    DB_RecordNativeAssetAlias(fixup, type, target);
+            }
+        }
+    }
+    else if (kind != bo1::ReferenceKind::absent)
+    {
+        target = static_cast<T *>(DB_FindNativeAssetAlias(encoded, type));
+    }
+    current = target;
+    if (sourceSlot)
+        DB_RecordNativeAssetAlias(sourceSlot, type, target);
+    DB_PopStreamPos();
+}
+}
