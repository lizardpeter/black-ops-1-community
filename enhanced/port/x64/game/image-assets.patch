+constexpr auto textureAliasType = static_cast<XAssetType>(-1);
+
+const unsigned char *ReserveImageFixup()
+{
+    DB_PushStreamPos(4);
+    const auto *slot = DB_GetNativeStreamSpan(3, sizeof(std::uint32_t));
+    if (slot)
+        DB_IncStreamPos(sizeof(std::uint32_t));
+    DB_PopStreamPos();
+    return slot;
+}
+
+void LoadNativeTexture(std::uint32_t encoded, GfxImage &image)
+{
+    DB_PushStreamPos(0);
+    const auto reference = bo1::DecodeFastfileReference(encoded);
+    if (reference.kind == bo1::ReferenceKind::inlineData ||
+        reference.kind == bo1::ReferenceKind::inlineWithFixup)
+    {
+        auto *header = DB_GetNativeStreamSpan(3, offsetof(GfxImageLoadDef, data));
+        const auto *fixup = reference.kind == bo1::ReferenceKind::inlineWithFixup ?
+            ReserveImageFixup() : nullptr;
+        if (header && (reference.kind != bo1::ReferenceKind::inlineWithFixup || fixup))
+        {
+            varGfxImageLoadDef = reinterpret_cast<GfxImageLoadDef *>(header);
+            Load_GfxImageLoadDef(true);
+            image.texture.loadDef = varGfxImageLoadDef;
+            Load_Texture(&image.texture, &image);
+            if (fixup)
+                DB_RecordNativeAssetAlias(fixup, textureAliasType, image.texture.basemap);
+        }
+    }
+    else if (reference.kind != bo1::ReferenceKind::absent)
+    {
+        image.texture.basemap = static_cast<IDirect3DBaseTexture9 *>(
+            DB_FindNativeAssetAlias(encoded, textureAliasType));
+    }
+    DB_PopStreamPos();
+}
+}
