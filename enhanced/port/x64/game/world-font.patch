+static_assert(sizeof(ComWaterCell) == 8 && sizeof(ComBurnableSample) == 1);
+
+ComPrimaryLight *LoadNativePrimaryLights(unsigned int count)
+{
+    const auto *records = ReadTableRecords<DiskPrimaryLight>(count);
+    if (!records)
+        return nullptr;
+    auto *lights = AllocateMaterialData<ComPrimaryLight>(count);
+    for (unsigned int i = 0; i < count; ++i)
+    {
+        const auto disk = MaterialRecordAt<DiskPrimaryLight>(records, i);
+        std::memcpy(static_cast<void *>(&lights[i]), disk.fields, sizeof(disk.fields));
+        lights[i].defName = disk.defName ? DB_ReadNativeAssetName(disk.defName) : nullptr;
+    }
+    return lights;
+}
+
+ComBurnableCell *LoadNativeBurnableCells(unsigned int count)
+{
+    const auto *records = ReadTableRecords<DiskBurnableCell>(count);
+    if (!records)
+        return nullptr;
+    auto *cells = AllocateMaterialData<ComBurnableCell>(count);
+    for (unsigned int i = 0; i < count; ++i)
+    {
+        const auto disk = MaterialRecordAt<DiskBurnableCell>(records, i);
+        cells[i].x = disk.x;
+        cells[i].y = disk.y;
+        if (disk.samples)
+            cells[i].data = reinterpret_cast<ComBurnableSample *>(ReadTableRecords<ComBurnableSample>(32, 0));
+    }
+    return cells;
+}
+}
