+const char *DB_ReadNativeAssetName(std::uint32_t encoded)
+{
+    const auto name = bo1::DecodeFastfileReference(encoded);
+    if (name.kind == bo1::ReferenceKind::inlineData)
+    {
+        const auto *start = DB_GetNativeStreamSpan(0, 1);
+        auto *character = const_cast<unsigned char *>(start);
+        while (character)
+        {
+            Load_Stream(true, character, 1);
+            if (!*character)
+                return reinterpret_cast<const char *>(start);
+            character = DB_GetNativeStreamSpan(0, 1);
+        }
+        return nullptr;
+    }
+    if (name.kind == bo1::ReferenceKind::blockOffset)
+    {
+        const auto &block = g_streamBlocks[name.block];
+        if (block.data && name.offset < block.size &&
+            std::memchr(block.data + name.offset, 0, block.size - name.offset))
+            return reinterpret_cast<const char *>(block.data + name.offset);
+    }
+    Com_Error(ERR_DROP, "Invalid fastfile asset name reference 0x%08x", encoded);
+    return nullptr;
+}
