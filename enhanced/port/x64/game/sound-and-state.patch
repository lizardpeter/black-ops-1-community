+namespace
+{
+struct DiskSoundArray
+{
+    std::uint32_t count;
+    std::uint32_t present;
+};
+
+template <typename T>
+T *LoadNativeSoundArray(DiskSoundArray disk)
+{
+    if (!disk.present || !disk.count)
+        return nullptr;
+    if (disk.count > INT32_MAX / sizeof(T))
+    {
+        Com_Error(ERR_DROP, "Invalid sound driver globals array size");
+        return nullptr;
+    }
+    const auto bytes = static_cast<int>(disk.count * sizeof(T));
+    auto *data = DB_GetNativeStreamSpan(3, bytes);
+    if (data)
+        Load_Stream(true, data, bytes);
+    return reinterpret_cast<T *>(data);
+}
