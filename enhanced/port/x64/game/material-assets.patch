+template <typename T>
+T *ReadMaterialData(std::uint32_t encoded, unsigned int count, int alignment)
+{
+    const auto reference = bo1::DecodeFastfileReference(encoded);
+    if (reference.kind == bo1::ReferenceKind::absent)
+        return nullptr;
+    if (count > INT32_MAX / sizeof(T))
+    {
+        Com_Error(ERR_DROP, "Invalid material array size");
+        return nullptr;
+    }
+    const auto size = static_cast<int>(sizeof(T) * count);
+    if (reference.kind == bo1::ReferenceKind::inlineData)
+    {
+        auto *data = DB_GetNativeStreamSpan(alignment, size);
+        if (data && size)
+            Load_Stream(true, data, size);
+        return reinterpret_cast<T *>(data);
+    }
+    if (reference.kind == bo1::ReferenceKind::blockOffset)
+    {
+        const auto &block = g_streamBlocks[reference.block];
+        if (block.data && reference.offset <= block.size &&
+            (reinterpret_cast<std::uintptr_t>(block.data + reference.offset) & alignment) == 0 &&
+            static_cast<unsigned int>(size) <= block.size - reference.offset)
+            return reinterpret_cast<T *>(block.data + reference.offset);
+    }
+    Com_Error(ERR_DROP, "Invalid material array reference");
+    return nullptr;
+}
+
+water_t *LoadNativeMaterialWater()
+{
+    const auto *bytes = ReadMaterialRecords<DiskMaterialWater>(1);
+    if (!bytes)
+        return nullptr;
+    const auto disk = MaterialRecordAt<DiskMaterialWater>(bytes);
+    const auto elements = static_cast<std::int64_t>(disk.m) * disk.n;
+    if (disk.m < 4 || disk.n < 4 || elements > INT32_MAX / static_cast<int>(sizeof(complex_s)))
+    {
+        Com_Error(ERR_DROP, "Invalid water material dimensions");
+        return nullptr;
+    }
+    auto *water = AllocateMaterialData<water_t>();
+    water->writable.floatTime = disk.time;
+    water->M = disk.m;
+    water->N = disk.n;
+    water->Lx = disk.lx;
+    water->Ly = disk.ly;
+    water->gravity = disk.gravity;
+    water->windvel = disk.windVelocity;
+    std::memcpy(water->winddir, disk.windDirection, sizeof(disk.windDirection));
+    water->amplitude = disk.amplitude;
+    std::memcpy(water->codeConstant, disk.codeConstant, sizeof(disk.codeConstant));
+    const auto count = static_cast<unsigned int>(elements);
+    water->H0 = ReadMaterialData<complex_s>(disk.h0 ? UINT32_MAX : 0, count, 3);
+    water->wTerm = ReadMaterialData<float>(disk.wTerm ? UINT32_MAX : 0, count, 3);
+    water->image = reinterpret_cast<GfxImage *>(static_cast<std::uintptr_t>(disk.image));
+    varGfxImagePtr = &water->image;
+    Load_GfxImagePtr(false);
+    Load_PicmipWater(&water);
+    return water;
+}
+
+MaterialTextureDef *LoadNativeMaterialTextures(unsigned int count)
+{
+    const auto *bytes = ReadMaterialRecords<DiskMaterialTexture>(count);
+    if (!bytes)
+        return nullptr;
+    auto *textures = AllocateMaterialData<MaterialTextureDef>(count);
+    for (unsigned int i = 0; i < count; ++i)
+    {
+        const auto disk = MaterialRecordAt<DiskMaterialTexture>(bytes, i);
+        auto &texture = textures[i];
+        texture.nameHash = disk.nameHash;
+        texture.nameStart = disk.nameStart;
+        texture.nameEnd = disk.nameEnd;
+        texture.samplerState = disk.samplerState;
+        texture.semantic = disk.semantic;
+        texture.isMatureContent = disk.isMatureContent;
+        if (disk.semantic == 11)
+        {
+            texture.u.water = LoadMaterialReference<water_t>(
+                disk.data, materialWaterAliasType, LoadNativeMaterialWater);
+        }
+        else
+        {
+            texture.u.image = reinterpret_cast<GfxImage *>(static_cast<std::uintptr_t>(disk.data));
+            varGfxImagePtr = &texture.u.image;
+            Load_GfxImagePtr(false);
+        }
+    }
+    return textures;
+}
