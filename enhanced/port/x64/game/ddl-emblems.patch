+struct DiskArrayRef
+{
+    std::int32_t count;
+    std::uint32_t present;
+};
+
+template <typename Native, typename Disk, typename Decode>
+Native *ReadNativeAssetArray(DiskArrayRef ref, Decode decode)
+{
+    if (ref.count < 0)
+    {
+        Com_Error(ERR_DROP, "Negative fastfile array count");
+        return nullptr;
+    }
+    if (!ref.present || !ref.count)
+        return nullptr;
+    const auto count = static_cast<unsigned int>(ref.count);
+    const auto *records = ReadTableRecords<Disk>(count);
+    if (!records)
+        return nullptr;
+    auto *objects = AllocateMaterialData<Native>(count);
+    for (unsigned int i = 0; i < count; ++i)
+        decode(objects[i], MaterialRecordAt<Disk>(records, i));
+    return objects;
+}
+
+const char *ReadOptionalNativeString(std::uint32_t encoded)
+{
+    return encoded ? DB_ReadNativeAssetName(encoded) : nullptr;
+}
