+namespace
+{
+struct DiskDDLMember
+{
+    std::uint32_t name;
+    unsigned char fields[44];
+};
+struct DiskDDLStruct
+{
+    std::uint32_t name;
+    std::int32_t size;
+    DiskArrayRef members;
+};
+struct DiskDDLEnum
+{
+    std::uint32_t name;
+    DiskArrayRef members;
+};
+struct DiskDDLDefinition
+{
+    std::int32_t version, size;
+    std::uint32_t structs;
+    std::int32_t structCount;
+    std::uint32_t enums;
+    std::int32_t enumCount;
+    std::uint32_t next;
+};
+struct DiskDDLRoot { std::uint32_t name, definition; };
+
+static_assert(sizeof(DiskDDLMember) == 48 && sizeof(DiskDDLStruct) == 16);
+static_assert(sizeof(DiskDDLEnum) == 12 && sizeof(DiskDDLDefinition) == 28);
+static_assert(sizeof(DiskDDLRoot) == 8);
+static_assert(offsetof(ddlMemberDef_t, permission) - offsetof(ddlMemberDef_t, size) == 40);
+
+void DecodeDDLMember(ddlMemberDef_t &member, const DiskDDLMember &disk)
+{
+    member.name = ReadOptionalNativeString(disk.name);
+    auto *fields = reinterpret_cast<unsigned char *>(&member) + offsetof(ddlMemberDef_t, size);
+    std::memcpy(fields, disk.fields, sizeof(disk.fields));
+}
+
+void DecodeDDLStruct(ddlStructDef_t &structure, const DiskDDLStruct &disk)
+{
+    structure.name = ReadOptionalNativeString(disk.name);
+    structure.size = disk.size;
+    structure.memberCount = disk.members.count;
+    structure.members = ReadNativeAssetArray<ddlMemberDef_t, DiskDDLMember>(disk.members, DecodeDDLMember);
+}
+
+void DecodeDDLEnum(ddlEnumDef_t &enumeration, const DiskDDLEnum &disk)
+{
+    enumeration.name = ReadOptionalNativeString(disk.name);
+    enumeration.memberCount = disk.members.count;
+    enumeration.members = ReadNativeAssetArray<const char *, std::uint32_t>(
+        disk.members, [](const char *&member, std::uint32_t encoded) {
+            member = ReadOptionalNativeString(encoded);
+        });
+}
+
+ddlDef_t *LoadNativeDDLDefinitions()
+{
+    ddlDef_t *first = nullptr;
+    auto **link = &first;
+    bool hasNext;
+    do
+    {
+        DiskDDLDefinition disk{};
+        if (!ReadTableHeader(true, disk))
+            break;
+        auto *definition = AllocateMaterialData<ddlDef_t>();
+        *link = definition;
+        definition->version = disk.version;
+        definition->size = disk.size;
+        definition->structCount = disk.structCount;
+        definition->enumCount = disk.enumCount;
+        definition->structList = ReadNativeAssetArray<ddlStructDef_t, DiskDDLStruct>(
+            {disk.structCount, disk.structs}, DecodeDDLStruct);
+        definition->enumList = ReadNativeAssetArray<ddlEnumDef_t, DiskDDLEnum>(
+            {disk.enumCount, disk.enums}, DecodeDDLEnum);
+        link = &definition->next;
+        hasNext = disk.next != 0;
+    }
+    while (hasNext);
+    return first;
+}
+}
