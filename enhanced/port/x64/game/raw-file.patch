+std::unordered_map<const unsigned char *, RawFile *> rawFileAliases;
+}
+
+unsigned char *DB_GetNativeStreamSpan(int alignment, unsigned int size)
+{
+    auto *data = DB_AllocStreamPos(alignment);
+    const auto &block = g_streamBlocks[g_streamPosIndex];
+    const auto base = reinterpret_cast<std::uintptr_t>(block.data);
+    const auto address = reinterpret_cast<std::uintptr_t>(data);
+    if (!block.data || address < base || address - base > block.size ||
+        size > block.size - (address - base))
+    {
+        Com_Error(ERR_DROP, "Fastfile read exceeds stream block %u", g_streamPosIndex);
+        return nullptr;
+    }
+    return data;
+}
+
+void DB_RecordRawFileAlias(const unsigned char *slot, RawFile *asset)
+{
+    rawFileAliases.insert_or_assign(slot, asset);
+}
+
+RawFile *DB_FindRawFileAlias(std::uint32_t encoded)
+{
+    const auto reference = bo1::DecodeFastfileReference(encoded);
+    if (reference.kind == bo1::ReferenceKind::blockOffset)
+    {
+        const auto &block = g_streamBlocks[reference.block];
+        if (block.data && reference.offset < block.size)
+        {
+            const auto entry = rawFileAliases.find(block.data + reference.offset);
+            if (entry != rawFileAliases.end())
+                return entry->second;
+        }
+    }
+    Com_Error(ERR_DROP, "Unresolved RawFile alias 0x%08x", encoded);
+    return nullptr;
+}
+
